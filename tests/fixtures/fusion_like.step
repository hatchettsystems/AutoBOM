#16 = MANIFOLD_SOLID_BREP('SOLID',#900);
#17 = MANIFOLD_SOLID_BREP('SOLID',#901);
/* two separate products for two screws, one of them mirrored */
#20 = PRODUCT('Screw:1','Screw:1','',(#2));
#21 = PRODUCT_DEFINITION_FORMATION('','',#20);
#22 = PRODUCT_DEFINITION('design','',#21,#6);
#23 = PRODUCT_DEFINITION_SHAPE('','',#22);
#24 = SHAPE_DEFINITION_REPRESENTATION(#23,#25);
#25 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#26),#99);
#26 = MANIFOLD_SOLID_BREP('SOLID',#902);
#30 = PRODUCT('Screw:2','Screw:2','',(#2));
#31 = PRODUCT_DEFINITION_FORMATION('','',#30);
#32 = PRODUCT_DEFINITION('design','',#31,#6);
#33 = PRODUCT_DEFINITION_SHAPE('','',#32);
#34 = SHAPE_DEFINITION_REPRESENTATION(#33,#35);
#35 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#36),#99);
#36 = MANIFOLD_SOLID_BREP('SOLID',#903);
#40 = PRODUCT('Screw(Mirror):1','Screw(Mirror):1','',(#2));
#41 = PRODUCT_DEFINITION_FORMATION('','',#40);
#42 = PRODUCT_DEFINITION('design','',#41,#6);
#43 = PRODUCT_DEFINITION_SHAPE('','',#42);
#44 = SHAPE_DEFINITION_REPRESENTATION(#43,#45);
#45 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#46),#99);
#46 = MANIFOLD_SOLID_BREP('SOLID',#904);
/* a plate whose geometry sits in a linked representation (the older AP203 way) */
#50 = PRODUCT('Gro\X2\00DF\X0\e Platte','Gro\X2\00DF\X0\e Platte','',(#2));
#51 = PRODUCT_DEFINITION_FORMATION('','',#50);
#52 = PRODUCT_DEFINITION('design','',#51,#6);
