ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Fusion style test file'),'2;1');
FILE_NAME('fusion_like.step','2026-01-01T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
/* root assembly */
#1 = PRODUCT('Gantry:1','Gantry:1','',(#2));
#2 = PRODUCT_CONTEXT('',#3,'mechanical');
#3 = APPLICATION_CONTEXT('automotive design');
#4 = PRODUCT_DEFINITION_FORMATION('','',#1);
#5 = PRODUCT_DEFINITION('design','',#4,#6);
#6 = PRODUCT_DEFINITION_CONTEXT('part definition',#3,'design');
/* a component that owns two bodies, both called SOLID */
#10 = PRODUCT('Bracket:1','Bracket:1','',(#2));
#11 = PRODUCT_DEFINITION_FORMATION('','',#10);
#12 = PRODUCT_DEFINITION('design','',#11,#6);
#13 = PRODUCT_DEFINITION_SHAPE('','',#12);
#14 = SHAPE_DEFINITION_REPRESENTATION(#13,#15);
