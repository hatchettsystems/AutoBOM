#54 = SHAPE_DEFINITION_REPRESENTATION(#53,#55);
#55 = SHAPE_REPRESENTATION('',(#98),#99);
#56 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#57),#99);
#57 = MANIFOLD_SOLID_BREP('SOLID',#905);
#58 = SHAPE_REPRESENTATION_RELATIONSHIP('','',#55,#56);
/* a component with nothing in it */
#60 = PRODUCT('Empty','Empty','',(#2));
#61 = PRODUCT_DEFINITION_FORMATION('','',#60);
#62 = PRODUCT_DEFINITION('design','',#61,#6);
/* placements: the Bracket twice, each screw once, the plate once, the empty component once */
#70 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','','',#5,#12,$);
#71 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('2','','',#5,#12,$);
#72 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('3','','',#5,#22,$);
#73 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('4','','',#5,#32,$);
#74 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('5','','',#5,#42,$);
#75 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('6','','',#5,#52,$);
#76 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('7','','',#5,#62,$);
#80 = (REPRESENTATION_RELATIONSHIP('','',#15,#55)REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#81)SHAPE_REPRESENTATION_RELATIONSHIP());
#98 = AXIS2_PLACEMENT_3D('',#97,$,$);
ENDSEC;
